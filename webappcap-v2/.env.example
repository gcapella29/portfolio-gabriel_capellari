NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Target used to validate customer CNAME records.
WEBAPPCAP_DOMAIN_CNAME=cname.vercel-dns.com
